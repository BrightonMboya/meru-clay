---
const details = [
  {
    label: 'ADDRESS',
    title: 'Meru Clay Tennis Club',
    body: 'Oltrumet, Ngaramtoni — Arusha, Tanzania. At the foot of Mount Meru.',
  },
  {
    label: 'HOURS',
    title: 'Daily, 06:00 — 21:00',
    body: 'Courts watered at noon and 5pm. Floodlights on from dusk.',
  },
  {
    label: 'CONTACT',
    title: '+255 782 628 288',
    body: 'WhatsApp to book a court or a lesson.',
  },
];

const mapsQuery = 'Meru Clay Tennis Club, Oltrumet';
const mapsEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(mapsQuery)}&z=15&output=embed`;
const mapsLink = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapsQuery)}`;
const whatsapp = 'https://wa.me/255782628288';
---

<section id="visit" class="bg-pine">
  <div class="mx-auto max-w-[1440px] px-6 py-20 md:px-16 md:py-[118px]">
    <!-- Head -->
    <div class="flex flex-col gap-[26px] pb-12 md:pb-14">
      <div class="flex items-center gap-[14px]">
        <span class="h-px w-[28px] bg-clay"></span>
        <span class="text-[13px] font-semibold tracking-[0.2em] text-[#7E8C84]">VISIT &amp; PLAY</span>
      </div>
      <h2 class="font-display text-[40px] font-medium leading-[1.0] tracking-[-0.02em] text-cream sm:text-[52px] lg:text-[64px]">
        Find us under<br />the mountain.
      </h2>
    </div>

    <div class="flex flex-col gap-10 md:flex-row md:gap-12">
      <!-- Map -->
      <div class="h-[320px] w-full shrink-0 overflow-clip rounded-[14px] border border-cream/10 bg-[#0E1E16] md:h-[520px] md:w-[700px]">
        <iframe
          title="Map to Meru Clay Tennis Club, Oltrumet, Ngaramtoni, Arusha"
          src={mapsEmbed}
          class="h-full w-full"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>

      <!-- Details -->
      <div class="flex flex-1 flex-col justify-between">
        {
          details.map((d) => (
            <div class="flex flex-col gap-3 border-b border-cream/15 py-[26px] first:pt-0 sm:flex-row sm:gap-6">
              <span class="w-[120px] shrink-0 pt-1 text-[12px] font-semibold tracking-[0.14em] text-[#7E8C84]">{d.label}</span>
              <div class="flex flex-col gap-[3px]">
                <span class="font-display text-[21px] font-medium leading-[26px] text-cream">{d.title}</span>
                <span class="text-[15px] leading-[24px] text-[#A9B4AC]">{d.body}</span>
              </div>
            </div>
          ))
        }
        <div class="flex items-center gap-[14px] pt-[30px]">
          <a
            href={whatsapp}
            target="_blank"
            rel="noopener"
            class="rounded-full bg-clay px-7 py-[15px] text-[15px] font-semibold text-white transition-transform hover:scale-[1.03]"
          >
            Book a Court
          </a>
          <a
            href={mapsLink}
            target="_blank"
            rel="noopener"
            class="rounded-full border border-cream/30 px-7 py-[15px] text-[15px] font-medium text-cream transition-colors hover:border-cream"
          >
            Get Directions
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
