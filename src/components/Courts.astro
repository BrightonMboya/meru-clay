---
const cards = [
  {
    img: '/images/court-academy.jpg',
    pos: 'object-[center_35%]',
    kicker: 'THE SURFACE',
    title: 'Two championship clay courts',
    body: 'Hand-laid crushed brick over a limestone base, brushed and watered twice a day for a true, slow bounce.',
    alt: 'Crushed-brick clay surface marked with crisp white lines under dappled shadow',
  },
  {
    img: '/images/court-floodlit.jpg',
    pos: 'object-[center_30%]',
    kicker: 'MATCH READY',
    title: 'Taut nets, true lines',
    body: 'Both courts are kept match-ready all day, with floodlights for cool Arusha evening sets long after the midday heat lifts.',
    alt: 'The net and white lines stretched taut across the red clay court',
  },
  {
    img: '/images/court-lesson.jpg',
    pos: 'object-[center_25%]',
    kicker: 'COACHING & CLUB',
    title: 'Coaching for every level',
    body: 'Clay-specialist coaches and a junior academy, plus a pro shop for balls, grips and strings — from a first lesson to match prep.',
    alt: 'A player holding her racket and a tennis ball on the clay court',
  },
];
---

<section id="courts" class="bg-pine">
  <div class="mx-auto max-w-[1440px] px-6 py-20 md:px-16 md:py-[115px]">
    <!-- Head -->
    <div class="flex flex-col gap-8 pb-12 md:flex-row md:items-end md:justify-between md:pb-16">
      <div class="flex flex-col gap-[26px]">
        <div class="flex items-center gap-[14px]">
          <span class="h-px w-[28px] bg-clay"></span>
          <span class="text-[13px] font-semibold tracking-[0.2em] text-[#7E8C84]">THE CLUB &amp; COURTS</span>
        </div>
        <h2 class="font-display text-[40px] font-medium leading-[1.0] tracking-[-0.02em] text-cream sm:text-[52px] lg:text-[64px]">
          Everything the<br />red dirt needs.
        </h2>
      </div>
      <p class="max-w-[360px] text-[16px] leading-[27px] text-[#C9D2CB] md:pb-2">
        Two courts, floodlights for cool evening sets, and a shaded terrace to watch from. Built to a
        single standard: play that feels like the clay season in Europe.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid gap-6 md:grid-cols-3">
      {
        cards.map((card) => (
          <article class="flex flex-col overflow-clip rounded-[12px] border border-cream/10 bg-[#19311F]">
            <div class="h-[210px] w-full overflow-clip">
              <img src={card.img} alt={card.alt} class={`h-full w-full object-cover ${card.pos}`} loading="lazy" />
            </div>
            <div class="flex flex-col px-[30px] pb-[34px] pt-7">
              <span class="mb-[14px] text-[12px] font-bold tracking-[0.16em] text-clay-light">{card.kicker}</span>
              <h3 class="mb-[14px] font-display text-[27px] font-medium leading-[32px] text-cream">{card.title}</h3>
              <p class="text-[15px] leading-[25px] text-[#A9B4AC]">{card.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
