---
const nav = [
  { label: 'About', href: '#about' },
  { label: 'The Courts', href: '#courts' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'Visit', href: '#visit' },
];

const whatsapp = 'https://wa.me/255782628288';
---

<section class="relative flex min-h-[640px] flex-col justify-between overflow-clip bg-pine lg:h-[880px]">
  <!-- Background photo -->
  <div class="absolute inset-0">
    <img
      src="/images/hero-court.jpg"
      alt="Clay tennis court at Meru Clay, a player serving in the low Arusha sun"
      class="h-full w-full object-cover object-[center_50%]"
      fetchpriority="high"
    />
  </div>
  <!-- Scrims -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[230px]"
    style="background-image:linear-gradient(180deg, rgba(13,30,22,0.62) 0%, rgba(13,30,22,0) 100%);"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[560px]"
    style="background-image:linear-gradient(0deg, rgba(13,30,22,0.92) 0%, rgba(13,30,22,0.55) 32%, rgba(13,30,22,0) 70%);"
  >
  </div>

  <!-- Nav -->
  <nav class="relative z-10 mx-auto flex w-full max-w-[1440px] items-center justify-between px-6 py-6 md:px-16 md:py-8">
    <a href="#" class="flex items-center gap-3">
      <img src="/images/logo-badge.png" alt="Meru Clay crest" class="h-11 w-11 shrink-0 rounded-lg object-cover" />
      <span class="font-display text-[22px] font-semibold text-white">Meru Clay</span>
    </a>

    <div class="hidden items-center gap-10 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[14px] font-medium tracking-[0.04em] text-cream-200 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <a
      href={whatsapp}
      target="_blank"
      rel="noopener"
      class="rounded-full bg-white px-[22px] py-[11px] text-[14px] font-semibold text-pine transition-transform hover:scale-[1.03]"
    >
      Book a Court
    </a>
  </nav>

  <!-- Hero content -->
  <div class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col px-6 pb-14 md:px-16 md:pb-[76px]">
    <h1 class="font-display text-cream">
      <span class="block text-[10vw] font-light leading-[0.96] tracking-[-0.03em] sm:text-[64px] lg:text-[104px] lg:leading-[94px]"
        >Tanzania's first</span
      >
      <span class="flex flex-wrap items-baseline gap-x-4 text-[10vw] font-semibold leading-[1.0] tracking-[-0.03em] sm:gap-x-[26px] sm:text-[64px] lg:text-[104px] lg:leading-[100px]">
        <span>true</span>
        <span class="italic text-clay-light">clay</span>
        <span>court.</span>
      </span>
    </h1>

    <div class="flex flex-col items-start gap-8 pt-9 md:flex-row md:items-end md:justify-between">
      <p class="max-w-[440px] text-[17px] leading-[27px] text-mist md:text-[18px] md:leading-[28px]">
        Crushed brick, the slow red bounce, and the long shadow of Mount Meru. A members' tennis
        club built around the most beautiful surface in the game.
      </p>
      <div class="flex shrink-0 items-center gap-[14px]">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-clay px-[30px] py-4 text-[15px] font-semibold text-white transition-transform hover:scale-[1.03]"
        >
          Book a Court
        </a>
        <a
          href="#pricing"
          class="rounded-full border border-cream/40 px-[30px] py-4 text-[15px] font-medium text-cream transition-colors hover:border-cream"
        >
          See Pricing
        </a>
      </div>
    </div>
  </div>
</section>
