---

<section id="pricing" class="bg-cream">
  <div class="mx-auto max-w-[1440px] px-6 py-20 md:px-16 md:py-[118px]">
    <!-- Head -->
    <div class="flex flex-col gap-8 pb-12 md:flex-row md:items-start md:justify-between md:gap-20 md:pb-[58px]">
      <div class="flex flex-col gap-[26px]">
        <div class="flex items-center gap-[14px]">
          <span class="text-[13px] font-bold tracking-[0.2em] text-clay">03</span>
          <span class="text-[13px] font-semibold tracking-[0.2em] text-[#7E8C84]">SCHEDULE &amp; PRICING</span>
        </div>
        <h2 class="flex flex-col font-display text-[48px] font-medium tracking-[-0.02em] lg:text-[64px]">
          <span class="leading-[0.97] text-[#1B1C18]">Play more.</span>
          <span class="italic leading-[1.0] text-clay">Pay less.</span>
        </h2>
      </div>
      <div class="flex max-w-[430px] flex-col gap-[18px] md:pt-2">
        <p class="text-[16px] leading-[27px] text-[#3C3F38]">
          Punch cards reward the players who keep showing up. Twelve, twenty-four or forty classes:
          the more you commit, the less you pay per session. Drop-ins are still welcome while you find
          your rhythm.
        </p>
        <span class="font-display text-[15px] italic text-[#7E8C84]">All prices in Tanzanian shillings.</span>
      </div>
    </div>

    <!-- 01 Drop-in -->
    <div class="flex items-center gap-[14px] border-t border-pine/20 pb-[26px] pt-[22px]">
      <span class="h-px w-[24px] bg-clay"></span>
      <span class="text-[12px] font-bold tracking-[0.18em] text-[#1B1C18]">SINGLE CLASS · DROP-IN</span>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        dropin.map((card) => (
          <div class="flex flex-col rounded-[10px] border border-pine/10 bg-[#FBF8F1] px-[30px] pb-3 pt-[30px]">
            <span class="mb-3 text-[11px] font-bold tracking-[0.18em] text-clay">{card.kicker}</span>
            <span class="mb-1.5 font-display text-[30px] font-medium italic leading-[36px] text-[#1B1C18]">{card.name}</span>
            <span class="mb-[22px] text-[14px] text-[#7E8C84]">{card.ages}</span>
            {
              card.rows.map((row) => (
                <div class="flex items-baseline justify-between gap-4 border-t border-pine/10 py-[14px]">
                  <span class="flex items-baseline gap-2">
                    <span class="text-[15px] font-medium text-[#1B1C18]">{row.label}</span>
                    <span class="font-display text-[13px] italic text-[#7E8C84]">{row.dur}</span>
                  </span>
                  <span class="text-[16px] font-bold text-[#1B1C18]">{row.price}</span>
                </div>
              ))
            }
          </div>
        ))
      }
    </div>

    <!-- 02 Punch cards -->
    <div class="mt-6 flex flex-col gap-8 rounded-[12px] bg-clay p-8 md:flex-row md:gap-11 md:p-11">
      <div class="flex shrink-0 flex-col justify-center gap-[14px] md:basis-[230px]">
        <span class="text-[11px] font-bold tracking-[0.18em] text-[#FBE6DE]">PUNCH CARDS</span>
        <span class="font-display text-[34px] font-medium italic leading-[34px] text-cream">Save up to 20%.</span>
      </div>
      <div class="flex flex-1 flex-col sm:flex-row">
        {
          punch.map((tier) => (
            <div class="flex flex-1 flex-col gap-3 border-cream/25 py-4 first:border-t-0 first:pt-1 [border-top-width:1px] sm:border-l sm:border-t-0 sm:px-7 sm:py-1 sm:first:pt-1">
              <span class="text-[12px] font-semibold tracking-[0.1em] text-[#FBE6DE]">{tier.qty}</span>
              <span class="text-[34px] font-bold tracking-[0.01em] leading-[42px] text-cream">{tier.total}</span>
              <span class="font-display text-[15px] italic text-[#FBE6DE]">{tier.per}</span>
              {
                tier.highlight ? (
                  <span class="mt-1.5 self-start rounded-[6px] bg-cream px-[13px] py-1.5 text-[11px] font-semibold tracking-[0.12em] text-[#B0492E]">
                    {tier.badge}
                  </span>
                ) : (
                  <span class="mt-1.5 self-start rounded-[6px] border border-cream/45 px-[13px] py-1.5 text-[11px] font-semibold tracking-[0.12em] text-cream">
                    {tier.badge}
                  </span>
                )
              }
            </div>
          ))
        }
      </div>
    </div>

    <!-- 03 Weekly schedule -->
    <div class="mt-14 flex items-center justify-between border-t border-pine/20 pb-6 pt-[22px]">
      <div class="flex items-center gap-[14px]">
        <span class="h-px w-[24px] bg-clay"></span>
        <span class="text-[12px] font-bold tracking-[0.18em] text-[#1B1C18]">WEEKLY SCHEDULE</span>
      </div>
      <span class="hidden font-display text-[14px] italic text-[#7E8C84] sm:block">two clay courts · floodlit court 1</span>
    </div>

    <div class="flex flex-col border-t border-pine/15 md:flex-row">
      {
        schedule.map((col) => (
          <div class={`flex flex-1 flex-col py-5 md:px-4 ${col.weekend ? 'bg-clay/5' : ''} border-t border-pine/10 first:border-t-0 md:border-l md:border-t-0 md:first:border-l-0`}>
            <span class={`pb-2 text-[13px] font-bold tracking-[0.1em] md:pb-4 ${col.weekend ? 'text-clay' : 'text-[#1B1C18]'}`}>
              {col.day}
            </span>
            <!-- mobile: sessions in a row-wrap grid; desktop: stacked column -->
            <div class="grid grid-cols-2 gap-x-4 sm:grid-cols-3 md:grid-cols-1 md:gap-x-0">
              {
                col.rows.map((row) => (
                  <div class="flex flex-col gap-0.5 border-t border-pine/10 py-3 md:border-t">
                    <span class="text-[12px] font-semibold tracking-[0.02em] text-[#3C3F38]">{row.time}</span>
                    <span class="font-display text-[15px] italic leading-[18px] text-[#1B1C18]">{row.name}</span>
                    {row.age && <span class="text-[12px] text-[#9AA39B]">{row.age}</span>}
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
