  {
    kicker: 'ADULTS',
    name: 'Adults',
    ages: '18 +',
    rows: [
      { label: 'Group clinic', dur: '1 hr', price: '15,000' },
      { label: 'Group social', dur: '1.5 hr', price: '15,000' },
      { label: 'Private', dur: '1 hr', price: '30,000' },
      { label: 'Private', dur: '1.5 hr', price: '45,000' },
    ],
  },
  {
    kicker: 'TEENAGERS',
    name: 'Teens',
    ages: '10 – 17 yrs',
    rows: [
      { label: 'Group clinic', dur: '1.5 hr', price: '15,000' },
      { label: 'Private', dur: '1 hr', price: '30,000' },
    ],
  },
  {
    kicker: 'KIDS',
