    weekend: false,
    rows: [
      { time: '4:00 – 5:00 PM', name: 'Pre-teens lesson', age: '10–12 yrs' },
      { time: '5:00 – 6:00 PM', name: 'Mixed clinic' },
      { time: '7:00 – 8:00 PM', name: 'Women clinic' },
    ],
  },
  {
    day: 'WED',
    weekend: false,
    rows: [
      { time: '4:00 – 5:00 PM', name: 'Juniors lesson', age: '7–9 yrs' },
      { time: '5:00 – 6:00 PM', name: 'Women clinic' },
      { time: '7:00 – 8:00 PM', name: 'Mixed clinic' },
    ],
  },
  {
    day: 'THU',
    weekend: false,
    rows: [
      { time: '4:00 – 5:00 PM', name: 'Tots lesson', age: '4–6 yrs' },
      { time: '5:00 – 6:00 PM', name: 'Mixed clinic' },
      { time: '7:00 – 8:00 PM', name: 'Women clinic' },
    ],
  },
  {
    day: 'FRI',
    weekend: false,
    rows: [
      { time: '5:30 – 7:00 PM', name: 'Women social' },
      { time: '7:00 – 8:30 PM', name: 'Mixed social' },
    ],
  },
  {
    day: 'SAT',
    weekend: true,
    rows: [
      { time: '9:00 AM', name: 'Tots', age: '4–6 yrs' },
