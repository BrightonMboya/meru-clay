      { time: '11:00 AM', name: 'Pre-teens', age: '10–12 yrs' },
      { time: '1:00 PM', name: 'Teens', age: '13–17 yrs' },
      { time: '4:30 PM', name: 'Mixed social' },
    ],
  },
  {
    day: 'SUN',
    weekend: true,
    rows: [
      { time: '9:00 AM', name: 'Tots', age: '4–6 yrs' },
      { time: '10:00 AM', name: 'Juniors', age: '7–9 yrs' },
      { time: '11:00 AM', name: 'Pre-teens', age: '10–12 yrs' },
