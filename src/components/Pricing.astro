  { qty: '40 CLASSES / 20 PRIVATES', total: '480,000', per: '12,000 per class', badge: 'SAVE 20%', highlight: true },
];

const schedule = [
  {
    day: 'MON',
    weekend: false,
    rows: [
      { time: '4:00 – 5:30 PM', name: 'Teens lesson', age: '13–17 yrs' },
      { time: '5:00 – 6:00 PM', name: 'Women clinic' },
      { time: '7:00 – 8:00 PM', name: 'Mixed clinic' },
