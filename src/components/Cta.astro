---
const whatsapp = 'https://wa.me/255782628288';
---

<section class="relative flex flex-col items-center overflow-clip bg-pine px-6 py-24 text-center md:px-16 md:py-[120px]">
  <img
    src="/images/cta-bounce.jpg"
    alt="Player mid-stride chasing a ball across the red clay"
    class="absolute inset-0 h-full w-full object-cover"
    loading="lazy"
  />
  <!-- Slight black overlay for contrast -->
  <div class="absolute inset-0 bg-black/25"></div>

  <div class="relative flex max-w-[640px] flex-col items-center">
    <span class="text-[13px] font-semibold tracking-[0.22em] text-[#FBE6DE]">MEMBERSHIPS OPEN FOR 2026</span>

    <h2 class="flex flex-col items-center pt-10 font-display text-[48px] font-medium tracking-[-0.025em] text-cream sm:text-[64px] lg:text-[76px] lg:leading-[74px]">
      <span>Come find</span>
      <span class="flex flex-wrap items-baseline justify-center gap-x-6">
        <span>your</span>
        <span class="italic text-clay-light">bounce.</span>
      </span>
    </h2>

    <p class="max-w-[460px] pt-[26px] text-[18px] leading-[28px] text-cream/90">
      Reserve a court, book your first lesson, or come watch a set from the terrace. The dirt is
      waiting.
    </p>

    <div class="flex flex-col items-center gap-[14px] pt-10">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-clay px-[36px] py-[17px] text-[16px] font-semibold text-white transition-transform hover:scale-[1.03]"
      >
        Book a Court
      </a>
    </div>
  </div>
</section>
