# Copy to .env (gitignored) and fill in. Next.js loads .env for both `next
# dev` and `next build`; drizzle-kit reads it too, via drizzle.config.ts.
#
# Public site origin — drives canonical URLs, Open Graph tags, robots.txt and
# the sitemap. Set this to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres.
#
# DATABASE_URL is the shared transaction-mode pooler (port 6543). It is what
# the app runs on: IPv4-reachable and safe for serverless, at the cost of
# prepared statements — src/lib/db/client.ts passes `prepare: false` for it.
#
# DIRECT_URL is session mode (port 5432) for migrations, which need DDL and
# advisory locks. drizzle.config.ts falls back to DATABASE_URL when it is
# unset. Both come from Project Settings > Database > Connection string.
NEXT_PUBLIC_SUPABASE_URL=
DATABASE_URL=
DIRECT_URL=

# Resend — the mail transport. Create a key at https://resend.com/api-keys.
# On the free tier, mail sent from onboarding@resend.dev reaches only the
# address that owns the Resend account, which is the point: that address is
# BOOKING_TO_EMAIL.
RESEND_API_KEY=

# Sender address. Resend's shared sender needs no domain of our own — the
# trade-off is that it only delivers to the address owning the Resend account.
# Swap to bookings@<verified-domain> once there is one.
BOOKING_FROM_EMAIL=onboarding@resend.dev

# Where new bookings are announced. Until the coach's WhatsApp template is
# approved, this inbox is the only thing that hears about a booking, so it
# must always be set.
BOOKING_TO_EMAIL=

CLUB_NAME=Meru Clay

# Meta WhatsApp Cloud API. Get the first two from the WhatsApp > API Setup page
# of your Meta app; the token there is a 24-hour test token, so swap it for a
# permanent System User token before launch.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Coach's number, E.164 without the leading "+".
COACH_WHATSAPP=255673034433

# Name of the approved message template. Leave EMPTY to send plain text
# instead, which only works within 24 hours of the coach messaging the
# business number — fine for testing, not for production.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# WhatsApp Business Account id — NOT the phone number id above, and not
# readable from it: the Cloud API's phone number node does not carry it.
#
# With it, the leads screen lists every template Meta has approved and the
# composer can send any of them. Without it, the composer falls back to the
# single name in WHATSAPP_TEMPLATE above, and the number panel says so.
#
# Find it in Meta App Dashboard > WhatsApp > API Setup, or simply send the
# club's number a message: the webhook logs the id the first time one
# arrives while this is unset.
WHATSAPP_WABA_ID=

# ── Leads / inbound WhatsApp ────────────────────────────────────────────────
# The webhook at /api/whatsapp/webhook needs both of these. Without them the
# club can send but never hears a reply — and since a reply is what opens the
# 24-hour free-messaging window, inbound is the half that matters most.

# Our own string. Paste the same value into Meta's App Dashboard >
# WhatsApp > Configuration > Verify token when saving the callback URL.
WHATSAPP_VERIFY_TOKEN=a-long-random-string-you-choose

# App secret, from Meta App Dashboard > App settings > Basic. Proves a webhook
# POST really came from Meta. The endpoint warns loudly and accepts unsigned
# requests while this is empty, which is fine on a local tunnel and is not
# fine anywhere else.
WHATSAPP_APP_SECRET=

# ── Realtime ────────────────────────────────────────────────────────────────
# Supabase Realtime carries a "lead N changed" nudge to open screens, so a
# reply appears in about a second instead of on the next poll. Both are
# optional: without them the screens fall back to polling and nothing breaks.
# See src/lib/realtime.ts for why the nudge carries an id and not the message.

# Publishable ("anon") key — Supabase dashboard > Project Settings > API keys.
# Public by design; it reaches the browser. It can join the broadcast channel
# and nothing else, which is why no conversation is ever sent over it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret ("service_role") key, server-side only, used to send the broadcast.
# NEVER prefix this NEXT_PUBLIC_. If unset, the publishable key above is used
# to broadcast instead, which also works.
SUPABASE_SECRET_KEY=

# ── Better Auth ──────────────────────────────────────────────────────────
# Signs session cookies and tokens. Rotating it logs everyone out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own origin. In production this is the deployed URL.
BETTER_AUTH_URL=http://localhost:3000
# Set to 'true' only while adding an operator; see user.validateUserInfo in
# src/lib/auth.ts. The very first account is allowed without it.
ADMIN_SIGNUP_OPEN=false
