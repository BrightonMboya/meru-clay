# Copy to .env (gitignored) and fill in. Next.js loads .env for both `next
# dev` and `next build`; drizzle-kit reads it too, via drizzle.config.ts.
#
# Public site origin — drives canonical URLs, Open Graph tags, robots.txt and
# the sitemap. Set this to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres.
#
# DATABASE_URL is the shared transaction-mode pooler (port 6543). It is what
# the app runs on: IPv4-reachable and safe for serverless, at the cost of
# prepared statements — src/lib/db/client.ts passes `prepare: false` for it.
#
# DIRECT_URL is session mode (port 5432) for migrations, which need DDL and
# advisory locks. drizzle.config.ts falls back to DATABASE_URL when it is
# unset. Both come from Project Settings > Database > Connection string.
NEXT_PUBLIC_SUPABASE_URL=
DATABASE_URL=
DIRECT_URL=

# Resend — the mail transport. Create a key at https://resend.com/api-keys.
# A send-only key is enough; nothing here reads the Resend account.
#
# Leave it unset in development and magic links print to the server log
# instead of being emailed (see sendMagicLink in src/lib/auth.ts), so invites
# can be exercised on a laptop. In production its absence is an error rather
# than a silent no-op — an invitation that was never sent must not look sent.
RESEND_API_KEY=

# Sender for everything the club sends: booking confirmations and the office
# invitations both. Whatever domain this sits on must be verified with Resend
# (Domains -> Add Domain, then the DNS records it asks for), or every send is
# refused. Resend's shared onboarding@resend.dev works without a domain but
# only delivers to the address owning the account — a development
# convenience, nothing more.
BOOKING_FROM_EMAIL=notifications@meruclay.com

# Where new bookings are announced. Until the coach's WhatsApp template is
# approved, this inbox is the only thing that hears about a booking, so it
# must always be set.
BOOKING_TO_EMAIL=

CLUB_NAME=Meru Clay

# Meta WhatsApp Cloud API. Get the first two from the WhatsApp > API Setup page
# of your Meta app; the token there is a 24-hour test token, so swap it for a
# permanent System User token before launch.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Coach's number, E.164 without the leading "+".
COACH_WHATSAPP=255673034433

# Name of the approved message template. Leave EMPTY to send plain text
# instead, which only works within 24 hours of the coach messaging the
# business number — fine for testing, not for production.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# WhatsApp Business Account id — NOT the phone number id above, and not
# readable from it: the Cloud API's phone number node does not carry it.
#
# With it, the leads screen lists every template Meta has approved and the
# composer can send any of them. Without it, the composer falls back to the
# single name in WHATSAPP_TEMPLATE above, and the number panel says so.
#
# Find it in Meta App Dashboard > WhatsApp > API Setup, or simply send the
# club's number a message: the webhook logs the id the first time one
# arrives while this is unset.
WHATSAPP_WABA_ID=

# ── Leads / inbound WhatsApp ────────────────────────────────────────────────
# The webhook at /api/whatsapp/webhook needs both of these. Without them the
# club can send but never hears a reply — and since a reply is what opens the
# 24-hour free-messaging window, inbound is the half that matters most.

# Our own string. Paste the same value into Meta's App Dashboard >
# WhatsApp > Configuration > Verify token when saving the callback URL.
WHATSAPP_VERIFY_TOKEN=a-long-random-string-you-choose

# App secret, from Meta App Dashboard > App settings > Basic. Proves a webhook
# POST really came from Meta. Required in production: with NODE_ENV=production
# and this empty, the endpoint refuses every delivery rather than trust it.
# Locally it warns and accepts unsigned requests, so a tunnel can be tested
# before the secret is to hand.
WHATSAPP_APP_SECRET=

# ── Realtime ────────────────────────────────────────────────────────────────
# Supabase Realtime carries a "lead N changed" nudge to open screens, so a
# reply appears in about a second instead of on the next poll. Both are
# optional: without them the screens fall back to polling and nothing breaks.
# See src/lib/realtime.ts for why the nudge carries an id and not the message.

# Publishable ("anon") key — Supabase dashboard > Project Settings > API keys.
# Public by design; it reaches the browser. It can join the broadcast channel
# and nothing else, which is why no conversation is ever sent over it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret ("service_role") key, server-side only, used to send the broadcast.
# NEVER prefix this NEXT_PUBLIC_. If unset, the publishable key above is used
# to broadcast instead, which also works.
SUPABASE_SECRET_KEY=

# ── Better Auth ──────────────────────────────────────────────────────────
# Signs session cookies and tokens. Rotating it logs everyone out.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own origin. In production this is the deployed URL.
BETTER_AUTH_URL=http://localhost:3000
# Set to 'true' only while adding an operator; see user.validateUserInfo in
# src/lib/auth.ts. The very first account is allowed without it.
ADMIN_SIGNUP_OPEN=false

# ── Taking money ────────────────────────────────────────────────────────────
# The club is on Snippe (snippe.sh), a Tanzanian payment provider covering
# M-Pesa, Airtel Money, Mixx by Yas and Halotel. Flutterwave was here first
# and was removed because it does not serve Tanzania.
#
# Snippe is a DIRECT-CHARGE provider: /pay/[id] collects the payer's number
# and a USSD prompt goes to that handset. There is no hosted checkout page
# and nothing to redirect to. src/lib/snippe.ts is the only file that knows
# any of this; everything else deals in a provider-neutral ledger.

# From Dashboard -> Settings -> API Keys. Shown once, so copy it there and
# then. An `snp_` key can charge; a `plk_` link key cannot and is no use
# here. Without it /pay says mobile money is not switched on, which is the
# honest thing for it to say.
SNIPPE_API_KEY=

# From Dashboard -> Settings -> Webhook Secret (or GET /api/v1/settings/
# webhook-secret). Used to verify the HMAC on every delivery to
# /api/payments/webhook.
#
# With this unset every delivery is refused, in every environment — unlike
# the WhatsApp webhook, which accepts unsigned posts on a laptop. The
# difference is what the endpoint can do: this one confirms courts and
# clears debts, and the local stub signs properly anyway, so there is
# nothing to be gained by leaving a hole.
SNIPPE_WEBHOOK_SECRET=

# Where the app looks for Snippe. Leave unset in production.
#
# It exists because Snippe has NO SANDBOX — their words: "There is no sandbox
# environment. Use a small live amount (minimum 500 TZS) to verify the
# end-to-end flow on a staging site, then enable on production." Pointing
# this at scripts/snippe-stub.mjs runs the whole payment path — charging,
# verifying, settling, fulfilling, the sweep — with no money moving and the
# same application code that will face the real thing.
#
#   SNIPPE_API_URL=http://localhost:4242
SNIPPE_API_URL=

# NOTE: the webhook URL is NOT configured here or in Snippe's dashboard. It
# is sent with every charge, derived from NEXT_PUBLIC_SITE_URL at the top of
# this file, which is what lets staging and production share one Snippe
# account without stealing each other's callbacks. Set that correctly on
# each deployment or the callbacks go to the wrong place.

# Name of the approved WhatsApp template used to send a membership payment
# link. Without it the club can only reach members who have written to the
# business number in the last 24 hours — see src/lib/paylink.ts. The template
# takes four body parameters: name, what, amount, link.
WHATSAPP_RENEWAL_TEMPLATE=

# ── Scheduled housekeeping ──────────────────────────────────────────────────
# POST /api/cron/payments expires dead links, retries fulfilment that failed
# transiently, and once a day sends membership renewal reminders. (Re-verifying
# payments whose webhook never arrived needs a provider to ask, and is the one
# step waiting on that choice — see the route's header.) It is a plain HTTP endpoint so it
# can be driven by Vercel Cron, a Cloudflare trigger, or any external pinger —
# see the header of that route for the schedule it expects.
#
# Sent as `authorization: Bearer <this>`. With it unset the endpoint refuses
# every request, which is the safe default for something that sends messages.
# Generate one with: openssl rand -base64 32
CRON_SECRET=
